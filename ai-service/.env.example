OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: leave unset to rotate through all free OpenRouter models.
# Set it to use specific models instead (must exist on openrouter.ai/models).
# OPENROUTER_MODEL=qwen/qwen3.8-27b

# Optional: must match AI_SERVICE_TOKEN given to the Spring Boot API
# AI_SERVICE_TOKEN=
